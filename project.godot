;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HandheldPortaitGodotReady"
config/description="Handheld Portait Godot Ready is a template primarily for mobile on Portrait mode  but it works on computer too."
config/version="0.0.6"
run/main_scene="uid://d1f5oobf5xpis"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/show_image=false
boot_splash/stretch_mode=0
config/icon="res://icon.svg"

[autoload]

DeviceManager="*uid://deub8qjtgovhd"
Global="*uid://o8oryr8jaj28"
SettingsManager="*uid://caqk2281od30q"
AudioManager="uid://qhrrrqsj0eh1"
AudioSoundUi="*uid://dk1s1plult3vb"
FindSvgInput="*uid://cani5hxxkfut2"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5

[editor]

movie_writer/movie_file="/home/gingin/GodotWorks/HandheldPortaitGodotReady/addons/HandheldPortraitGodotReady/Assets/Video/starter.ogv"

